# =========================
# Python and Environment
# =========================
__pycache__/
*.py[cod]
*$py.class
.venv/
.venv*/
.env
.env*/
.envrc
*.env
*.log
*.bak

# =========================
# IDE and OS Files
# =========================
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# =========================
# Data and Intermediate Files
# =========================
data/
*.csv
*.parquet
*.npz
*.pkl
*.json
!models/SCALER.json     # allow only scaler JSON to be tracked

# =========================
# Model Artifacts
# =========================
*.h5
*.ckpt
*.onnx
*.pth
*.pt
models/
checkpoints/
runs/
!models/SCALER.json     # explicitly re-allow scaler JSON

# =========================
# Output and Results
# =========================
results/
logs/
reports/
plots/
backtests/
exports/

# =========================
# Temporary / Backup Files
# =========================
*.tmp
*.temp
*.old
*.orig
*.backup
*.bak

# =========================
# Project Scripts Control
# =========================
# ignore experimental and backups
scripts/phase*_*.bak
scripts/phase*_diagnostic.py

# explicitly include your main working scripts
!scripts/phase6_ml_backtest.py
!scripts/phase6_hybrid_backtest.py
!generate_phase_summary.py

# =========================
# Documents and Office Files
# =========================
*.doc
*.docx
*.pdf
*.xls
*.xlsx
*.ppt
*.pptx

# =========================
# Misc
# =========================
__MACOSX/
*.zip
*.tar
*.gz
*.7z
